            <group id="typography" translate="label comment" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Button Typography</label>
                <comment>Applies to both Primary and Secondary buttons. Leave empty to keep the theme default.</comment>

                <field id="desktop_size" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Desktop Font Size (px)</label>
                    <comment>Applies on screens 768px and wider. Example: 16</comment>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends><field id="general/enabled">1</field></depends>
                </field>
                <field id="mobile_size" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Mobile Font Size (px)</label>
                    <comment>Applies on screens below 768px. Example: 14</comment>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends><field id="general/enabled">1</field></depends>
                </field>
                <field id="font_weight" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Font Weight</label>
                    <source_model>Harshad\Buttons\Model\Config\Source\FontWeight</source_model>
                    <depends><field id="general/enabled">1</field></depends>
