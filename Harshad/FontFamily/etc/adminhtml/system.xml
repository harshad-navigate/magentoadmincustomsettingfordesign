<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="harshad_fontfamily" translate="label" type="text" sortOrder="40"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Font Family</label>
            <tab>harshad</tab>
            <resource>Harshad_FontFamily::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Custom Fonts</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="google" translate="label comment" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Google Fonts</label>
                <comment>Enter one font name per line, for example Poppins. All available font weights are loaded automatically from Google. Maximum 5 fonts.</comment>
                <field id="fonts" translate="label" type="textarea" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google Fonts List</label>
                    <depends><field id="general/enabled">1</field></depends>
                </field>
            </group>

            <group id="custom" translate="label comment" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Custom Font CDN Links</label>
                <comment>Use this if the font is not available on Google Fonts. Enter one https CSS link per line, for example https://cdn.example.com/fonts/myfont.css. Google Fonts and Bunny Fonts links are automatically loaded with all weights. For other CDNs, the weights included in the CSS file are loaded.</comment>
                <field id="urls" translate="label" type="textarea" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>CDN CSS Links</label>
                    <depends><field id="general/enabled">1</field></depends>
                </field>
            </group>

            <group id="apply" translate="label comment" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Apply Fonts</label>
                <comment>Enter the exact font family name (as on Google Fonts, or the font-family defined in your CDN CSS). Leave empty to keep the theme default font.</comment>
                <field id="body_font" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Body Font</label>
                    <comment>Example: Poppins</comment>
                    <depends><field id="general/enabled">1</field></depends>
                </field>
                <field id="heading_font" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Heading Font (H1 - H6)</label>
                    <comment>Example: Playfair Display</comment>
                    <depends><field id="general/enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
