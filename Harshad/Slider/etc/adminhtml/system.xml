<field id="position" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1"><label>Position on Home Page</label><comment>Start / End place the slider automatically on the home page. For any other place choose &quot;Only via CMS&quot; and add this to a CMS block or page: {{block class=&quot;Harshad\Slider\Block\Slider&quot; template=&quot;Harshad_Slider::slider.phtml&quot;}}</comment><source_model>Harshad\Slider\Model\Config\Source\Options::position</source_model><depends><field id="enabled">1</field></depends></field>
<field id="width_mode" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1"><label>Slider Width</label><source_model>Harshad\Slider\Model\Config\Source\Options::widthMode</source_model><depends><field id="enabled">1</field></depends></field>
<field id="ratio_desktop" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1"><label>Desktop Image Size (width x height)</label><comment>Example: 1920x600. Used to reserve space so the page does not jump while loading.</comment><depends><field id="enabled">1</field></depends></field>
<field id="ratio_mobile" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1"><label>Mobile Image Size (width x height)</label><comment>Example: 750x900. Used below 768px.</comment><depends><field id="enabled">1</field></depends></field>
