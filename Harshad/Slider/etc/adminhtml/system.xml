<field id="autoplay" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1"><label>Autoplay</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model><depends><field id="enabled">1</field></depends></field>
