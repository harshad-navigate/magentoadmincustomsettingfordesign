<?php
declare(strict_types=1);

use Harshad\Slider\Block\Slider;
use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;

/** @var Slider $block */
/** @var Escaper $escaper */
/** @var SecureHtmlRenderer $secureRenderer */

if (!$block->isAllowed()) {
    return;
}

$vm = $block->getViewModel();
$slides = $vm->getSlides();
$count = count($slides);
$id = $block->nextId();
$nav = $vm->getNavType();
$showArrows = $count > 1 && in_array($nav, ['arrows', 'both'], true);
$showDots = $count > 1 && in_array($nav, ['dots', 'both'], true);
$allowedHtml = ['b', 'strong', 'i', 'em', 'br', 'span'];

$chevronLeft = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>';
$chevronRight = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>';
?>
<?php if ($block->shouldPrintCss()): ?>
    <style id="harshad-slider-css">
