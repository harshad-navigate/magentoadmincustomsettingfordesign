        .hs-dp-c .hs-dots{left:50%;transform:translateX(-50%)}
        .hs-dp-l .hs-dots{left:16px}
        .hs-dp-r .hs-dots{right:16px}
        .hs-dot{width:10px;height:10px;padding:0;border:0;border-radius:50%;cursor:pointer;background:var(--hs-dc);opacity:.5}
        .hs-dot[aria-current="true"]{background:var(--hs-da);opacity:1}
    </style>
<?php endif; ?>

    <section id="<?= $escaper->escapeHtmlAttr($id) ?>"
             class="<?= $escaper->escapeHtmlAttr($vm->getRootClasses()) ?>"
             style="<?= $escaper->escapeHtmlAttr($vm->getStyleVars()) ?>"
             data-hs="1"
             data-loop="<?= $vm->isLoop() ? '1' : '0' ?>"
             data-autoplay="<?= (int) $vm->getAutoplayMs() ?>"
             data-pause="<?= $vm->isPauseOnHover() ? '1' : '0' ?>"
             role="region"
             aria-roledescription="carousel"
             aria-label="<?= $escaper->escapeHtmlAttr(__('Slider')) ?>">
        <div class="hs-track">
            <?php foreach ($slides as $i => $s): ?>
                <?php
                $target = $s['new_tab'] ? ' target="_blank" rel="noopener noreferrer"' : '';
                $hasContent = $s['heading'] !== '' || $s['text'] !== '' || ($s['button_text'] !== '' && $s['button_url'] !== '');
                $first = ($i === 0);
                $bgStyle = $s['bg'] !== '' ? ' style="background:' . $escaper->escapeHtmlAttr($s['bg']) . '"' : '';
                ?>
                <div class="hs-slide" role="group" aria-roledescription="slide"
                     aria-label="<?= (int) ($i + 1) ?> / <?= (int) $count ?>"<?= /* @noEscape */ $bgStyle ?>>
                    <?php if ($s['desktop'] !== ''): ?>
                        <picture>
                            <?php if ($s['mobile'] !== ''): ?>
                                <source media="(max-width:767px)" srcset="<?= $escaper->escapeUrl($s['mobile']) ?>">
                            <?php endif; ?>
                            <img src="<?= $escaper->escapeUrl($s['desktop']) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($s['alt']) ?>"
                                 width="1920" height="600"
                                 decoding="async"
                                <?= $first ? 'fetchpriority="high"' : 'loading="lazy"' ?>>
                        </picture>
                    <?php endif; ?>

                    <?php if ($s['overlay'] > 0 && $s['desktop'] !== ''): ?>
                        <span class="hs-ov" style="opacity:<?= (int) $s['overlay'] / 100 ?>"></span>
                    <?php endif; ?>

                    <?php if ($s['link'] !== ''): ?>
                        <a class="hs-cover" href="<?= $escaper->escapeUrl($s['link']) ?>"<?= /* @noEscape */ $target ?>
                           aria-label="<?= $escaper->escapeHtmlAttr($s['heading'] !== '' ? $s['heading'] : __('Open slide')) ?>"></a>
                    <?php endif; ?>

                    <?php if ($hasContent): ?>
                        <div class="hs-c"
                             style="justify-content:<?= $escaper->escapeHtmlAttr($s['justify']) ?>;align-items:<?= $escaper->escapeHtmlAttr($s['align_items']) ?>">
                            <div class="hs-box"
                                 style="--w:<?= (int) $s['width'] ?>%;text-align:<?= $escaper->escapeHtmlAttr($s['text_align']) ?>;color:<?= $escaper->escapeHtmlAttr($s['color']) ?>">
                                <?php if ($s['heading'] !== ''): ?>
                                    <h2 class="hs-h"><?= $escaper->escapeHtml($s['heading']) ?></h2>
                                <?php endif; ?>
                                <?php if ($s['text'] !== ''): ?>
                                    <p class="hs-t"><?= /* @noEscape */ nl2br($escaper->escapeHtml($s['text'], $allowedHtml)) ?></p>
                                <?php endif; ?>
                                <?php if ($s['button_text'] !== '' && $s['button_url'] !== ''): ?>
                                    <div class="hs-b" style="text-align:<?= $escaper->escapeHtmlAttr($s['btn_align']) ?>">
                                        <a class="<?= $escaper->escapeHtmlAttr($s['button_class']) ?>"
                                           href="<?= $escaper->escapeUrl($s['button_url']) ?>"<?= /* @noEscape */ $target ?>>
                                            <?= $escaper->escapeHtml($s['button_text']) ?>
                                        </a>
                                    </div>
                                <?php endif; ?>
                            </div>
                        </div>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>

        <?php if ($showArrows): ?>
            <button type="button" class="hs-arrow hs-prev" aria-label="<?= $escaper->escapeHtmlAttr(__('Previous slide')) ?>"><?= /* @noEscape */ $chevronLeft ?></button>
            <button type="button" class="hs-arrow hs-next" aria-label="<?= $escaper->escapeHtmlAttr(__('Next slide')) ?>"><?= /* @noEscape */ $chevronRight ?></button>
        <?php endif; ?>

        <?php if ($showDots): ?>
            <div class="hs-dots">
                <?php for ($k = 0; $k < $count; $k++): ?>
                    <button type="button" class="hs-dot" aria-current="<?= $k === 0 ? 'true' : 'false' ?>"
                            aria-label="<?= $escaper->escapeHtmlAttr(__('Go to slide %1', $k + 1)) ?>"></button>
                <?php endfor; ?>
            </div>
        <?php endif; ?>
    </section>

<?php if ($count > 1 && $block->shouldPrintJs()): ?>
    <?php
    $js = <<<'JS'
(function(){
function init(root){
    if(root.__hs){return;}
    root.__hs=1;
    var track=root.querySelector('.hs-track');
    var slides=[].slice.call(track.children);
    var n=slides.length;
    if(n<2){return;}
    var loop=root.getAttribute('data-loop')==='1';
    var delay=parseInt(root.getAttribute('data-autoplay'),10)||0;
    var hoverPause=root.getAttribute('data-pause')==='1';
    var dots=[].slice.call(root.querySelectorAll('.hs-dot'));
    var prevBtn=root.querySelector('.hs-prev');
    var nextBtn=root.querySelector('.hs-next');
    var off=0,idx=0,timer=null,paused=false,visible=true,t;
    if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches){delay=0;}

    if(loop){
        var f=slides[0].cloneNode(true),l=slides[n-1].cloneNode(true);
        [f,l].forEach(function(c){
            c.setAttribute('aria-hidden','true');
            c.setAttribute('inert','');
            [].forEach.call(c.querySelectorAll('img'),function(im){
                im.setAttribute('loading','lazy');
                im.removeAttribute('fetchpriority');
            });
        });
        track.appendChild(f);
        track.insertBefore(l,track.firstChild);
        off=1;
        track.scrollLeft=track.clientWidth;
    }

    function w(){return track.clientWidth;}
    function pos(i,smooth){track.scrollTo({left:(i+off)*w(),behavior:smooth?'smooth':'auto'});}
    function mark(){
        dots.forEach(function(d,k){d.setAttribute('aria-current',k===idx?'true':'false');});
        if(!loop){
            if(prevBtn){prevBtn.disabled=idx===0;}
            if(nextBtn){nextBtn.disabled=idx===n-1;}
        }
    }
    function next(){if(!loop&&idx>=n-1){pos(0,true);}else{pos(idx+1,true);}}
    function prev(){pos(idx-1,true);}
    function jump(p){
        track.style.scrollSnapType='none';
        track.scrollLeft=p*w();
        requestAnimationFrame(function(){track.style.scrollSnapType='';});
    }
    function settle(){
        var p=Math.round(track.scrollLeft/(w()||1));
        if(loop){
            if(p<=0){jump(n);p=n;}
            else if(p>=n+1){jump(1);p=1;}
        }
        idx=Math.max(0,Math.min(n-1,p-off));
        mark();
        restart();
    }
    function start(){if(!delay||timer||paused||!visible||document.hidden){return;}timer=setInterval(next,delay);}
    function stop(){if(timer){clearInterval(timer);timer=null;}}
    function restart(){stop();start();}

    track.addEventListener('scroll',function(){clearTimeout(t);t=setTimeout(settle,90);},{passive:true});
    if(prevBtn){prevBtn.addEventListener('click',prev);}
    if(nextBtn){nextBtn.addEventListener('click',next);}
    dots.forEach(function(d,k){d.addEventListener('click',function(){pos(k,true);});});
    window.addEventListener('resize',function(){pos(idx,false);},{passive:true});
    document.addEventListener('visibilitychange',function(){if(document.hidden){stop();}else{start();}});

    if(hoverPause){
        root.addEventListener('mouseenter',function(){paused=true;stop();});
        root.addEventListener('mouseleave',function(){paused=false;start();});
    }
    root.addEventListener('focusin',function(){paused=true;stop();});
    root.addEventListener('focusout',function(){paused=false;start();});

    if('IntersectionObserver' in window){
        new IntersectionObserver(function(e){
            visible=e[0].isIntersecting;
            if(visible){start();}else{stop();}
        },{threshold:0.2}).observe(root);
    }

    mark();
    (window.requestIdleCallback||function(fn){setTimeout(fn,1500);})(start);
}
function run(){[].forEach.call(document.querySelectorAll('.hs[data-hs]'),init);}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}
})();
JS;
    ?>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $js, false) ?>
<?php endif; ?>
