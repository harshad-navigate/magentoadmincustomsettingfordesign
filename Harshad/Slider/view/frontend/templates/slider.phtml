        .hs--full{width:100vw;max-width:100vw;margin-left:calc(50% - 50vw)}
        .hs-track{display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
        .hs-track::-webkit-scrollbar{display:none}
        .hs-slide{position:relative;flex:0 0 100%;min-width:0;scroll-snap-align:start;scroll-snap-stop:always;aspect-ratio:var(--hs-ar-m)}
        @media (min-width:768px){.hs-slide{aspect-ratio:var(--hs-ar-d)}}
        .hs-slide picture{display:block;width:100%;height:100%}
        .hs-slide img{display:block;width:100%;height:100%;object-fit:cover}
        .hs-ov{position:absolute;inset:0;background:#000;pointer-events:none}
        .hs-cover{position:absolute;inset:0;z-index:1}
        .hs-c{position:absolute;inset:0;z-index:2;display:flex;padding:24px;box-sizing:border-box;pointer-events:none}
        .hs-box{pointer-events:auto;width:var(--w,50%);max-width:100%}
        @media (max-width:767px){.hs-box{width:100%}.hs-c{padding:16px}}
        .hs-h{margin:0 0 12px;font-size:clamp(1.5rem,4vw,3rem);line-height:1.15;font-weight:700;color:inherit}
        .hs-t{margin:0 0 16px;font-size:clamp(1rem,1.6vw,1.25rem);line-height:1.5;color:inherit}
        .hs-b .btn{display:inline-block}
        .hs-arrow{position:absolute;z-index:3;width:40px;height:40px;padding:0;border:0;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;background:var(--hs-ab);color:var(--hs-ac);opacity:.9}
        .hs-arrow:hover{opacity:1}
        .hs-arrow:disabled{opacity:.35;cursor:default}
        .hs-noam .hs-arrow{display:none}
