<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Harshad\Slider\Block\Slider"
                   name="harshad.slider.start"
                   template="Harshad_Slider::slider.phtml"
                   before="-">
                <arguments>
                    <argument name="position" xsi:type="string">start</argument>
                </arguments>
            </block>
            <block class="Harshad\Slider\Block\Slider"
                   name="harshad.slider.end"
                   template="Harshad_Slider::slider.phtml"
                   after="-">
                <arguments>
                    <argument name="position" xsi:type="string">end</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
